{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist",
    "types": ["node", "mocha", "chai"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["hardhat.config.ts", "test/**/*.ts", "scripts/**/*.ts", "typechain-types/**/*.ts"]
}
