# MongoDB connection string
MONGO_URI=

# Secret used to sign organizer and staff JWTs
JWT_SECRET=

# Private key of the redeemer wallet authorized to mark tickets redeemed
BACKEND_PRIVATE_KEY=

# Gate QR validity window in ms. Defaults to 60000 (60s anti-replay window).
# Raise only for local manual testing — never widen it in production.
GATE_FRESHNESS_MS=

# Base Sepolia JSON-RPC endpoint
RPC_URL=

# Deployed contract addresses
EVENT_TICKET_ADDR=
MARKETPLACE_ADDR=
